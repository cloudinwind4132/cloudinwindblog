---
import { Icon } from "astro-icon/components";
import type { Project } from "@/types/projects";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
  project: Project;
  maxTechStack?: number;
}

const { project, maxTechStack = 4 } = Astro.props;

const showImageArea = project.showImage !== false && !!project.image;
const visibleTech = project.techStack.slice(0, maxTechStack);
const overflowCount = project.techStack.length - maxTechStack;
const hasOverflow = overflowCount > 0;
const hasVisit = !!project.visitUrl;
const hasSource = !!project.sourceCode;
const hasLinks = hasVisit || hasSource;
const isFeatured = !!project.featured;

const statusText = (() => {
  switch (project.status) {
    case "completed": return i18n(I18nKey.projectStatusCompleted);
    case "in-progress": return i18n(I18nKey.projectStatusInProgress);
    case "planned": return i18n(I18nKey.projectStatusPlanned);
    default: return project.status;
  }
})();

const sourceLabel = hasVisit ? "" : i18n(I18nKey.projectsSource);
const sourceBtnClass = hasVisit ? "" : "flex-1";
---

<div
  class="project-card group rounded-xl border border-black/10 dark:border-white/10 overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1 bg-(--card-bg)"
  data-category={project.category}
>
  {showImageArea ? (
    <div class="relative overflow-hidden aspect-video">
      <img src={project.image} alt={project.title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      {isFeatured && (
        <div class="absolute top-3 right-3 bg-(--primary) text-white rounded-lg px-2 py-1 text-xs font-medium flex items-center gap-1">
          <Icon name="material-symbols:star-rounded" class="w-3.5 h-3.5" />
          {i18n(I18nKey.projectsFeatured)}
        </div>
      )}
    </div>
  ) : (
    <div class="relative overflow-hidden aspect-video bg-(--btn-regular-bg) flex items-center justify-center">
      <Icon name="material-symbols:code" class="w-12 h-12 text-black/15 dark:text-white/15" />
    </div>
  )}

  <div class="p-5">
    <div class="flex items-center justify-between mb-2">
      <h3 class="text-lg font-bold truncate text-black/90 dark:text-white/90 group-hover:text-(--primary) transition-colors duration-200">
        {project.title}
      </h3>
      <span class="shrink-0 ml-2 px-2 py-0.5 text-xs rounded-md bg-(--primary)/10 text-(--primary) font-medium">
        {statusText}
      </span>
    </div>

    <p class="text-sm text-black/60 dark:text-white/60 mb-4 line-clamp-2 min-h-10">
      {project.description}
    </p>

    <div class="flex flex-wrap gap-2 mb-4">
      {visibleTech.map((tech) => (
        <span class="px-2 py-1 text-xs rounded-md bg-(--primary)/10 text-(--primary) font-medium">{tech}</span>
      ))}
      {hasOverflow && (
        <span class="px-2 py-1 text-xs rounded-md bg-black/5 dark:bg-white/10 text-black/40 dark:text-white/40 font-medium">+{overflowCount}</span>
      )}
    </div>

    {hasLinks && (
      <div class="flex gap-2 mt-auto">
        {hasVisit && (
          <a href={project.visitUrl} target="_blank" rel="noopener noreferrer"
            class="btn-regular flex-1 flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium">
            <Icon name="material-symbols:open-in-new" class="w-3.5 h-3.5" />
            {i18n(I18nKey.projectsVisit)}
          </a>
        )}
        {hasSource && (
          <a href={project.sourceCode} target="_blank" rel="noopener noreferrer"
            class={`btn-regular flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium ${sourceBtnClass}`}>
            <Icon name="mdi:github" class="w-4 h-4" />
            {sourceLabel}
          </a>
        )}
      </div>
    )}
  </div>

  <div class="absolute inset-0 bg-linear-to-br from-(--primary)/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-xl"></div>
</div>

<style>
  .project-card {
    animation: fadeInUp 0.5s ease-out forwards;
    opacity: 0;
  }
  .project-card.filtered-out {
    display: none;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .project-card:nth-child(1) { animation-delay: 0.05s; }
  .project-card:nth-child(2) { animation-delay: 0.1s; }
  .project-card:nth-child(3) { animation-delay: 0.15s; }
  .project-card:nth-child(4) { animation-delay: 0.2s; }
  .project-card:nth-child(5) { animation-delay: 0.25s; }
  .project-card:nth-child(6) { animation-delay: 0.3s; }
  .project-card:nth-child(7) { animation-delay: 0.35s; }
  .project-card:nth-child(8) { animation-delay: 0.4s; }
</style>
